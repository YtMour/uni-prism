{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "sourceMap": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2020", "DOM"],
    "types": ["vite/client"]
  },
  "include": [
    "env.d.ts",
    "App.vue",
    "main.ts",
    "pages/**/*.vue",
    "data/**/*.ts",
    "services/**/*.ts",
    "types/**/*.ts",
    "vite.config.ts"
  ]
}
