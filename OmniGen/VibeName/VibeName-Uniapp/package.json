{
  "name": "vibename-uniapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:h5": "set UNI_INPUT_DIR=.&& uni -p h5 --host 127.0.0.1 --port 5191 --strictPort",
    "build:h5": "set UNI_INPUT_DIR=.&& uni build -p h5",
    "test": "node --test",
    "sample:quality": "node scripts/sample-quality.mjs",
    "audit:ui": "node scripts/audit-ui-source.mjs",
    "audit:i18n": "node scripts/audit-i18n.mjs",
    "audit:visual": "node scripts/audit-visual-report.mjs",
    "audit:deps": "node scripts/audit-deps.mjs",
    "smoke:h5": "node scripts/smoke-h5.mjs",
    "smoke:browser": "node scripts/smoke-browser.mjs",
    "check": "npm test && npm run sample:quality && npm run audit:ui && npm run audit:i18n && npm run build:h5 && npm run smoke:h5 && npm run audit:visual && npm run smoke:browser && npm run audit:deps"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-4020920240930001",
    "@dcloudio/vite-plugin-uni": "3.0.0-4020920240930001",
    "vite": "5.4.21",
    "vue": "3.4.21"
  },
  "devDependencies": {
    "playwright": "^1.61.1"
  }
}
